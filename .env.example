# Токен бота из @BotFather
BOT_TOKEN=

# Локальный Postgres из docker-compose.yml
DATABASE_URL=postgres://sc:sc@localhost:5432/sc

# HTTPS-адрес Mini App (в разработке — адрес туннеля cloudflared на порт 5173).
# Пока пусто, бот не показывает кнопку открытия приложения.
WEBAPP_URL=

# ID рабочей группы для отчётов (узнать: добавить бота в группу и написать /chatid)
GROUP_CHAT_ID=

# Telegram ID администраторов через запятую — их создаёт db:seed (узнать свой: /start боту)
ADMIN_TELEGRAM_IDS=

# Только для разработки: открывать фронт в обычном браузере от имени этого пользователя
DEV_TELEGRAM_ID=

PORT=3000
