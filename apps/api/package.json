{
  "name": "@sc/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --watch src/index.ts",
    "start": "node src/index.ts",
    "typecheck": "tsc",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=../../.env src/db/migrate.ts",
    "db:seed": "node --env-file=../../.env src/db/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@sc/shared": "workspace:*",
    "@tma.js/init-data-node": "^2.0.8",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "grammy": "^1.46.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
